# Frontend (Vite) — expostos no bundle, NUNCA usar service_role aqui
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_ALLOW_SIGNUP=true          # só em dev; produção = convite via /admin/usuarios
# VITE_UI_PREVIEW=true            # demo sem backend (nunca ligar em produção)

# Backend scripts (Node) — só usados em scripts/* e edge functions
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar (OAuth das edge functions)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_PROJECT_REF.supabase.co/functions/v1/google-calendar-sync/callback

# WhatsApp — chat do dia a dia (WAHA). Sessão/número exclusivos desta instância.
WAHA_URL=https://sua-instancia-waha.example.com
WAHA_API_KEY=
WAHA_SESSION=
WHATSAPP_WEBHOOK_SECRET=

# Templates oficiais Meta + Instagram — via Chatwoot Cloud (não aparecem na UI do usuário)
CHATWOOT_URL=https://app.chatwoot.com
CHATWOOT_ACCOUNT_ID=
CHATWOOT_TOKEN=
CHATWOOT_INSTAGRAM_INBOX_ID=
CHATWOOT_WHATSAPP_INBOX_ID=
# WHATSAPP_TEMPLATE_ALLOWLIST=
CHATWOOT_WEBHOOK_SECRET=

# IA SDR (opcional) — handoff WhatsApp → pipeline
SDR_HANDOFF_SECRET=
SDR_PAUSAR_SECRET=

# Cron / saúde / alertas / agenda
AGENDA_SYNC_SECRET=
AGENDA_CALENDAR_ID=agenda@empresa.example.com
ALERTA_WHATSAPP_CHATID=
ALERTA_WAHA_SESSION=

# Meta Lead Ads (opcional)
# META_VERIFY_TOKEN=
# META_PAGE_ACCESS_TOKEN=
# META_APP_SECRET=
