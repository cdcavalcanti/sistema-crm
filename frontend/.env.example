# --- Backend Nest (recomendado) ---
# Com o backend rodando (`npm run dev:backend` ou docker compose), descomente:
# VITE_API_URL=/api/v1
# VITE_USE_API=true

# VITE_ALLOW_SIGNUP=true          # só em dev; produção = convite via /admin/usuarios
# VITE_UI_PREVIEW=true            # botão Demonstração (sem dados reais). Homolog/local: ligar. Produção: off.
# Sem API e sem Supabase no `npm run dev`, a demonstração liga sozinha.

# --- Legado Supabase (só se ainda não migrou para Nest) ---
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=
