# Postgres deste tenant (Nest + Prisma). Não commitar .env.
DATABASE_URL=postgresql://vortex:vortex@localhost:5432/vortex_crm

# JWT — gere um valor longo e único por cliente
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=7d

# Primeiro super_admin (só cria se a tabela users estiver vazia)
BOOTSTRAP_ADMIN_EMAIL=voce@empresa.com
BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha
BOOTSTRAP_ADMIN_NOME=Admin

# Convite: signup público off por padrão (espelha VITE_ALLOW_SIGNUP)
ALLOW_SIGNUP=false

# CORS do Vite em dev
CORS_ORIGIN=http://localhost:8080

# Webhooks públicos (leads / ads)
INGEST_LEADS_SECRET=
INDICADORES_ADS_SECRET=

# IA (opcional) — o mesmo gateway do assistente
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

PORT=3000
